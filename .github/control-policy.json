    "SECURITY_AND_TOOL_POLICY.md",
    "Makefile",
    "requirements-dev.txt",
    ".github/control-policy.json",
    ".github/pull_request_template.md",
    ".github/dependabot.yml",
    ".github/workflows/ci.yml",
    ".github/workflows/dependency-review.yml",
    ".github/workflows/sensitive-scan.yml",
    ".github/workflows/repository-controls.yml",
    "tools/scan_sensitive_changes.py",
    "tools/control_audit.py",
    "tools/agent_card_validate.py",
    ".well-known/agent-card.json",
    "tools/mcp/tools.json",
    "docs/CI_AND_LIVE_STATE.md"
