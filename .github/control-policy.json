{
  "schema_version": 1,
  "repository_kind": "healthcare-local-stdlib-prototype",
  "visibility": "public",
  "scanner_mode": "block",
  "instruction_sources": [
    "LOAD.md",
    "AGENTS.md",
    "CLAUDE.md",
    "SECURITY_AND_TOOL_POLICY.md"
  ],
